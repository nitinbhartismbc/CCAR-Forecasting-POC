<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ccar</groupId>
        <artifactId>ccar-forecasting-parent</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>ccar-forecasting-service</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>ccar-forecasting-service</name>
    <description>CCAR stress-scenario forecasts (baseline / adverse / severely adverse)</description>

    <dependencies>
        <!-- REST API (Spring MVC + embedded Tomcat + Jackson) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- @Valid request bodies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Enables ccar-common's LoggingAspect (controller/service entry, exit and timing) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Shared error catalogue, GlobalExceptionHandler, correlation-id filter and AOP LoggingAspect -->
        <dependency>
            <groupId>com.ccar</groupId>
            <artifactId>ccar-common</artifactId>
        </dependency>
        <!-- Pooled KDB+ access (KdbTemplate); ccar-common maps its KdbExceptions to 502/503/504 -->
        <dependency>
            <groupId>com.iris.kdb</groupId>
            <artifactId>kdb-starter</artifactId>
        </dependency>
        <!-- Swagger UI at /ccar/swagger-ui.html -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest slice (Spring Boot 4 split the MVC test support into its own starter) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>ccar-forecasting-service</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
